{
  "schema_version": "2",
  "id": "core-controlnet",
  "name": "Core ControlNet",
  "version": "1.0.0",
  "category": "controlnet",
  "media_type": "image",
  "supported_ecosystems": ["sd15", "sdxl"],
  "loader_family": "checkpoint",
  "component_policy": {"clip": "embedded", "vae": "embedded"},
  "workflow": "workflow.json",
  "description": "Guided image generation conditioned on structural, pose, or depth reference images.",
  "capability_notes": ["Checkpoint generation guided by ControlNet model and reference conditioning image."],
  "limitation_notes": ["Requires a compatible ControlNet model matching the checkpoint ecosystem."],
  "required_nodes": ["CheckpointLoaderSimple", "ControlNetLoader", "LoadImage", "CLIPTextEncode", "ControlNetApply", "EmptyLatentImage", "KSampler", "VAEDecode", "SaveImage"],
  "resource_slots": {
    "checkpoint": {"label": "Checkpoint", "accepts": ["checkpoint"], "required": true, "binding": {"kind": "node_input", "node_id": "1", "input": "ckpt_name"}},
    "controlnet": {"label": "ControlNet model", "accepts": ["controlnet"], "required": true, "binding": {"kind": "node_input", "node_id": "2", "input": "control_net_name"}},
    "loras": {"label": "LoRA networks", "accepts": ["lora", "locon", "dora"], "required": false, "multiple": true, "binding": {"kind": "lora_chain", "source_node_id": "1"}}
  },
  "fields": [
    {"id": "control_image", "label": "Conditioning image", "kind": "image", "section": "Reference", "default": "", "required": true, "description": "Pose, depth, edge, or lineart guidance image.", "bindings": [{"node_id": "3", "input": "image"}]},
    {"id": "control_strength", "label": "Control strength", "kind": "number", "section": "Reference", "default": 1.0, "minimum": 0.0, "maximum": 2.0, "step": 0.05, "advanced": true, "bindings": [{"node_id": "6", "input": "strength"}]},
    {"id": "positive_prompt", "label": "Positive prompt", "kind": "textarea", "section": "Prompt", "default": "Highly detailed portrait following control pose, masterpiece quality", "required": true, "bindings": [{"node_id": "4", "input": "text"}]},
    {"id": "negative_prompt", "label": "What to avoid", "kind": "textarea", "section": "Prompt", "default": "low quality, bad anatomy, deformed", "advanced": true, "bindings": [{"node_id": "5", "input": "text"}]},
    {"id": "width", "label": "Width", "kind": "number", "section": "Image", "default": 1024, "minimum": 64, "maximum": 8192, "step": 8, "advanced": true, "bindings": [{"node_id": "7", "input": "width"}]},
    {"id": "height", "label": "Height", "kind": "number", "section": "Image", "default": 1024, "minimum": 64, "maximum": 8192, "step": 8, "advanced": true, "bindings": [{"node_id": "7", "input": "height"}]},
    {"id": "seed", "label": "Seed", "kind": "seed", "section": "Sampling", "default": -1, "minimum": -1, "maximum": 1125899906842624, "step": 1, "advanced": true, "bindings": [{"node_id": "8", "input": "seed"}]},
    {"id": "steps", "label": "Quality steps", "kind": "number", "section": "Sampling", "default": 28, "minimum": 1, "maximum": 200, "step": 1, "advanced": true, "bindings": [{"node_id": "8", "input": "steps"}]},
    {"id": "cfg", "label": "Prompt strength (CFG)", "kind": "number", "section": "Sampling", "default": 7, "minimum": 0, "maximum": 30, "step": 0.1, "advanced": true, "bindings": [{"node_id": "8", "input": "cfg"}]},
    {"id": "sampler", "label": "Sampling method", "kind": "select", "section": "Sampling", "default": "dpmpp_2m", "advanced": true, "options": [{"value": "euler", "label": "Euler"}, {"value": "dpmpp_2m", "label": "DPM++ 2M"}], "bindings": [{"node_id": "8", "input": "sampler_name"}]},
    {"id": "scheduler", "label": "Sampling schedule", "kind": "select", "section": "Sampling", "default": "karras", "advanced": true, "options": [{"value": "normal", "label": "Normal"}, {"value": "karras", "label": "Karras"}], "bindings": [{"node_id": "8", "input": "scheduler"}]},
    {"id": "filename_prefix", "label": "Filename prefix", "kind": "text", "section": "Output", "default": "CMV/ControlNet", "advanced": true, "bindings": [{"node_id": "10", "input": "filename_prefix"}]}
  ],
  "output_nodes": ["10"]
}
