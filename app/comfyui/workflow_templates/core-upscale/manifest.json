{
  "schema_version": "2",
  "id": "core-upscale",
  "name": "Core hi-res upscale",
  "version": "1.0.0",
  "category": "upscale",
  "media_type": "image",
  "supported_ecosystems": ["sd15", "sdxl", "pony", "illustrious"],
  "loader_family": "checkpoint",
  "component_policy": {"clip": "embedded", "vae": "embedded"},
  "workflow": "workflow.json",
  "description": "Model-assisted upscale pipeline combining ESRGAN/SwinIR super-resolution with latent diffusion refinement.",
  "capability_notes": ["Image super-resolution followed by tile-free checkpoint refinement to enhance fine textures."],
  "limitation_notes": ["Requires an upscale model (ESRGAN, RealESRGAN, SwinIR, DAT) installed in ComfyUI models/upscale_models."],
  "required_nodes": ["CheckpointLoaderSimple", "LoadImage", "UpscaleModelLoader", "ImageUpscaleWithModel", "VAEEncode", "CLIPTextEncode", "KSampler", "VAEDecode", "SaveImage"],
  "resource_slots": {
    "checkpoint": {"label": "Refiner checkpoint", "accepts": ["checkpoint"], "required": true, "binding": {"kind": "node_input", "node_id": "1", "input": "ckpt_name"}},
    "upscale_model": {"label": "Upscale model", "accepts": ["upscale_model"], "required": true, "binding": {"kind": "node_input", "node_id": "3", "input": "model_name"}},
    "loras": {"label": "LoRA networks", "accepts": ["lora", "locon", "dora"], "required": false, "multiple": true, "binding": {"kind": "lora_chain", "source_node_id": "1"}}
  },
  "fields": [
    {"id": "source_image", "label": "Source image", "kind": "image", "section": "Reference", "default": "", "required": true, "description": "Input image to upscale.", "bindings": [{"node_id": "2", "input": "image"}]},
    {"id": "positive_prompt", "label": "Enhancement prompt", "kind": "textarea", "section": "Prompt", "default": "High resolution, sharp details, crisp textures, professional photograph", "required": true, "bindings": [{"node_id": "6", "input": "text"}]},
    {"id": "negative_prompt", "label": "What to avoid", "kind": "textarea", "section": "Prompt", "default": "blur, noise, compression artifacts, distortion", "advanced": true, "bindings": [{"node_id": "7", "input": "text"}]},
    {"id": "seed", "label": "Seed", "kind": "seed", "section": "Sampling", "default": -1, "minimum": -1, "maximum": 1125899906842624, "step": 1, "advanced": true, "bindings": [{"node_id": "8", "input": "seed"}]},
    {"id": "steps", "label": "Refine steps", "kind": "number", "section": "Sampling", "default": 20, "minimum": 1, "maximum": 200, "step": 1, "advanced": true, "bindings": [{"node_id": "8", "input": "steps"}]},
    {"id": "denoise", "label": "Refine denoise strength", "kind": "number", "section": "Sampling", "default": 0.35, "minimum": 0.05, "maximum": 1.0, "step": 0.01, "advanced": true, "bindings": [{"node_id": "8", "input": "denoise"}]},
    {"id": "cfg", "label": "Prompt strength (CFG)", "kind": "number", "section": "Sampling", "default": 6.0, "minimum": 0, "maximum": 30, "step": 0.1, "advanced": true, "bindings": [{"node_id": "8", "input": "cfg"}]},
    {"id": "sampler", "label": "Sampling method", "kind": "select", "section": "Sampling", "default": "dpmpp_2m", "advanced": true, "options": [{"value": "euler", "label": "Euler"}, {"value": "dpmpp_2m", "label": "DPM++ 2M"}], "bindings": [{"node_id": "8", "input": "sampler_name"}]},
    {"id": "scheduler", "label": "Sampling schedule", "kind": "select", "section": "Sampling", "default": "karras", "advanced": true, "options": [{"value": "normal", "label": "Normal"}, {"value": "karras", "label": "Karras"}], "bindings": [{"node_id": "8", "input": "scheduler"}]},
    {"id": "filename_prefix", "label": "Filename prefix", "kind": "text", "section": "Output", "default": "CMV/Upscale", "advanced": true, "bindings": [{"node_id": "10", "input": "filename_prefix"}]}
  ],
  "output_nodes": ["10"]
}
