{
  "schema_version": "2",
  "id": "core-inpaint",
  "name": "Core inpaint",
  "version": "1.0.0",
  "category": "inpaint",
  "media_type": "image",
  "supported_ecosystems": ["sd15", "sdxl", "pony", "illustrious"],
  "loader_family": "checkpoint",
  "component_policy": {"clip": "embedded", "vae": "embedded"},
  "workflow": "workflow.json",
  "description": "Inpainting workflow replacing or restoring designated image regions with mask conditioning.",
  "capability_notes": ["Checkpoint-contained image inpainting with adjustable grow mask border and denoise."],
  "limitation_notes": ["Requires an input image with an associated mask or transparent alpha channel."],
  "required_nodes": ["CheckpointLoaderSimple", "LoadImage", "VAEEncodeForInpaint", "CLIPTextEncode", "KSampler", "VAEDecode", "SaveImage"],
  "resource_slots": {
    "checkpoint": {"label": "Checkpoint", "accepts": ["checkpoint"], "required": true, "binding": {"kind": "node_input", "node_id": "1", "input": "ckpt_name"}},
    "loras": {"label": "LoRA networks", "accepts": ["lora", "locon", "dora"], "required": false, "multiple": true, "binding": {"kind": "lora_chain", "source_node_id": "1"}}
  },
  "fields": [
    {"id": "reference_image", "label": "Source image & mask", "kind": "image", "section": "Reference", "default": "", "required": true, "description": "Source image with mask area.", "bindings": [{"node_id": "2", "input": "image"}]},
    {"id": "grow_mask_by", "label": "Grow mask padding", "kind": "number", "section": "Reference", "default": 6, "minimum": 0, "maximum": 64, "step": 1, "advanced": true, "bindings": [{"node_id": "3", "input": "grow_mask_by"}]},
    {"id": "positive_prompt", "label": "Positive prompt", "kind": "textarea", "section": "Prompt", "default": "Detailed target element replacing masked area, seamless blending", "required": true, "bindings": [{"node_id": "4", "input": "text"}]},
    {"id": "negative_prompt", "label": "What to avoid", "kind": "textarea", "section": "Prompt", "default": "seams, artifacts, bad blend, low quality", "advanced": true, "bindings": [{"node_id": "5", "input": "text"}]},
    {"id": "seed", "label": "Seed", "kind": "seed", "section": "Sampling", "default": -1, "minimum": -1, "maximum": 1125899906842624, "step": 1, "advanced": true, "bindings": [{"node_id": "6", "input": "seed"}]},
    {"id": "steps", "label": "Quality steps", "kind": "number", "section": "Sampling", "default": 28, "minimum": 1, "maximum": 200, "step": 1, "advanced": true, "bindings": [{"node_id": "6", "input": "steps"}]},
    {"id": "cfg", "label": "Prompt strength (CFG)", "kind": "number", "section": "Sampling", "default": 7, "minimum": 0, "maximum": 30, "step": 0.1, "advanced": true, "bindings": [{"node_id": "6", "input": "cfg"}]},
    {"id": "denoise", "label": "Inpaint strength", "kind": "number", "section": "Sampling", "default": 0.85, "minimum": 0, "maximum": 1, "step": 0.01, "advanced": true, "bindings": [{"node_id": "6", "input": "denoise"}]},
    {"id": "sampler", "label": "Sampling method", "kind": "select", "section": "Sampling", "default": "dpmpp_2m", "advanced": true, "options": [{"value": "euler", "label": "Euler"}, {"value": "dpmpp_2m", "label": "DPM++ 2M"}], "bindings": [{"node_id": "6", "input": "sampler_name"}]},
    {"id": "scheduler", "label": "Sampling schedule", "kind": "select", "section": "Sampling", "default": "karras", "advanced": true, "options": [{"value": "normal", "label": "Normal"}, {"value": "karras", "label": "Karras"}], "bindings": [{"node_id": "6", "input": "scheduler"}]},
    {"id": "filename_prefix", "label": "Filename prefix", "kind": "text", "section": "Output", "default": "CMV/Inpaint", "advanced": true, "bindings": [{"node_id": "8", "input": "filename_prefix"}]}
  ],
  "output_nodes": ["8"]
}
